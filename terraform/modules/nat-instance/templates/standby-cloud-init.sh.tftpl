#!/bin/bash
set -e

# =============================================================================
# NAT Configuration
# =============================================================================

echo "net.ipv4.ip_forward = 1" >> /etc/sysctl.d/98-nat.conf
sysctl -w net.ipv4.ip_forward=1

for i in /proc/sys/net/ipv4/conf/*/rp_filter; do
  echo 0 > "$i"
done
echo "net.ipv4.conf.all.rp_filter = 0" >> /etc/sysctl.d/98-nat.conf
echo "net.ipv4.conf.default.rp_filter = 0" >> /etc/sysctl.d/98-nat.conf

cat >> /etc/sysctl.d/98-nat.conf << 'SYSCTL'
net.core.default_qdisc = fq_codel
net.core.netdev_max_backlog = 8192
net.netfilter.nf_conntrack_max = 131072
net.netfilter.nf_conntrack_tcp_timeout_established = 600
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 30
net.netfilter.nf_conntrack_udp_timeout = 30
net.netfilter.nf_conntrack_udp_timeout_stream = 120
SYSCTL

modprobe nf_conntrack 2>/dev/null || true
sysctl -p /etc/sysctl.d/98-nat.conf 2>/dev/null || true

MEM_KB=$(awk '/MemTotal/ {print $2}' /proc/meminfo)
CONNTRACK_MAX=$((MEM_KB / 8))
if [ "$CONNTRACK_MAX" -lt 32768 ]; then
  CONNTRACK_MAX=32768
fi
if [ "$CONNTRACK_MAX" -gt 262144 ]; then
  CONNTRACK_MAX=262144
fi
CONNTRACK_HASHSIZE=$((CONNTRACK_MAX / 4))
sysctl -w net.netfilter.nf_conntrack_max="$CONNTRACK_MAX" 2>/dev/null || true
echo "net.netfilter.nf_conntrack_max = $CONNTRACK_MAX" >> /etc/sysctl.d/98-nat.conf
if [ -w /sys/module/nf_conntrack/parameters/hashsize ]; then
  echo "$CONNTRACK_HASHSIZE" > /sys/module/nf_conntrack/parameters/hashsize || true
fi

DEFAULT_IF=$(ip route get 1.1.1.1 | grep -oP 'dev \K\S+' | head -1)
if [ -z "$DEFAULT_IF" ]; then
  DEFAULT_IF=$(ip route show default | grep -oP 'dev \K\S+' | head -1)
fi
if [ -z "$DEFAULT_IF" ]; then
  echo "ERROR: Could not detect default interface" >&2
  exit 1
fi

if ! command -v nft &> /dev/null; then
  dnf install -y nftables 2>/dev/null || yum install -y nftables 2>/dev/null || true
fi

if ! command -v ethtool &> /dev/null; then
  dnf install -y ethtool 2>/dev/null || yum install -y ethtool 2>/dev/null || true
fi

modprobe nf_flow_table 2>/dev/null || true
modprobe nf_flow_table_ipv4 2>/dev/null || true

if command -v nft &> /dev/null; then
  cat > /etc/nftables/nat.nft << NFTEOF
table ip nat {
    chain postrouting {
        type nat hook postrouting priority srcnat; policy accept;
        ip saddr ${private_subnet_cidr} oifname "$DEFAULT_IF" masquerade
    }
}

table inet filter {
    flowtable f {
        hook ingress priority 0;
        devices = { $${DEFAULT_IF} };
    }

    chain forward {
        type filter hook forward priority 0; policy accept;
        ip protocol { tcp, udp } flow add @f
        ip saddr ${private_subnet_cidr} oifname "$DEFAULT_IF" tcp flags syn tcp option maxseg size set rt mtu
    }
}
NFTEOF

  touch /etc/sysconfig/nftables.conf
  grep -qF 'include "/etc/nftables/nat.nft"' /etc/sysconfig/nftables.conf || echo 'include "/etc/nftables/nat.nft"' >> /etc/sysconfig/nftables.conf
  systemctl enable --now nftables
elif command -v iptables &> /dev/null; then
  iptables -t nat -A POSTROUTING -o "$DEFAULT_IF" -s ${private_subnet_cidr} -j MASQUERADE
  iptables -t mangle -A FORWARD -o "$DEFAULT_IF" -p tcp --tcp-flags SYN,RST SYN -s ${private_subnet_cidr} -j TCPMSS --clamp-mss-to-pmtu

  if command -v iptables-save &> /dev/null; then
    iptables-save > /etc/sysconfig/iptables
  fi

  if systemctl list-unit-files | grep -q iptables; then
    systemctl enable iptables
  fi
else
  echo "ERROR: Neither nftables nor iptables available" >&2
  exit 1
fi

if command -v ethtool &> /dev/null; then
  ethtool -K "$DEFAULT_IF" gro on gso on tso on rx on tx on 2>/dev/null || true
fi

# =============================================================================
# Failover Monitoring
# =============================================================================

dnf install -y python3-oci-cli 2>/dev/null || yum install -y python3-oci-cli 2>/dev/null || true

cat > /usr/local/bin/nat-failover.sh << 'FAILOVER_SCRIPT'
#!/bin/bash
PRIMARY_IP="${primary_private_ip}"
ROUTE_TABLE_ID="${route_table_id}"
CHECK_INTERVAL=10
FAIL_THRESHOLD=3
fail_count=0

get_my_private_ip_id() {
  local instance_id=$(curl -sH "Authorization: Bearer Oracle" http://169.254.169.254/opc/v2/instance/id)
  local compartment_id=$(curl -sH "Authorization: Bearer Oracle" http://169.254.169.254/opc/v2/instance/compartmentId)
  
  oci network private-ip list \
    --compartment-id "$compartment_id" \
    --auth instance_principal \
    --query "data[0].id" \
    --raw-output 2>/dev/null
}

wait_for_iam_propagation() {
  local max_attempts=20
  local attempt=1
  logger -t nat-failover "Waiting for IAM policy propagation (can take 1-5 minutes)..."
  
  while [ $attempt -le $max_attempts ]; do
    MY_PRIVATE_IP_ID=$(get_my_private_ip_id)
    if [ -n "$MY_PRIVATE_IP_ID" ]; then
      logger -t nat-failover "IAM propagated after $attempt attempts"
      return 0
    fi
    logger -t nat-failover "IAM not ready, retrying ($attempt/$max_attempts)..."
    sleep 15
    ((attempt++))
  done
  return 1
}

wait_for_iam_propagation

if [ -z "$MY_PRIVATE_IP_ID" ]; then
  logger -t nat-failover "ERROR: IAM policy not propagated after 5 minutes. Check dynamic group configuration."
  exit 1
fi

logger -t nat-failover "Starting failover monitor (primary=$PRIMARY_IP, my_ip_id=$MY_PRIVATE_IP_ID)"

while true; do
  if ping -c 1 -W 2 "$PRIMARY_IP" > /dev/null 2>&1; then
    fail_count=0
  else
    ((fail_count++))
    logger -t nat-failover "Primary NAT unreachable ($fail_count/$FAIL_THRESHOLD)"
    
    if [ $fail_count -ge $FAIL_THRESHOLD ]; then
      logger -t nat-failover "Initiating failover to standby"
      
      oci network route-table update \
        --rt-id "$ROUTE_TABLE_ID" \
        --route-rules "[{\"destination\":\"0.0.0.0/0\",\"destinationType\":\"CIDR_BLOCK\",\"networkEntityId\":\"$MY_PRIVATE_IP_ID\"}]" \
        --force \
        --auth instance_principal 2>&1 | logger -t nat-failover
      
      if [ $? -eq 0 ]; then
        logger -t nat-failover "Failover complete - now active"
        # Stay running but stop checking (we're now primary)
        while true; do sleep 3600; done
      fi
    fi
  fi
  sleep $CHECK_INTERVAL
done
FAILOVER_SCRIPT

chmod +x /usr/local/bin/nat-failover.sh

cat > /etc/systemd/system/nat-failover.service << 'SERVICE'
[Unit]
Description=NAT Failover Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nat-failover.sh
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
SERVICE

systemctl daemon-reload
systemctl enable nat-failover.service
systemctl start nat-failover.service

echo "NAT standby configuration complete"

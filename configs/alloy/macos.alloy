// Grafana Alloy config for the Macs (Homebrew `grafana-alloy`, Apple Silicon
// prefix /opt/homebrew). Runbook: docs/lgtm-taylor-pc.md.
//
// Laptops come and go, so this ships node metrics and Homebrew service logs only.
// macOS has no journal. The stack's MagicDNS name is read from a one-line file
// instead of being committed here:
//   /opt/homebrew/etc/grafana-alloy/lgtm-host   e.g. taylor-pc.<tailnet>.ts.net
// Override the path with the LGTM_HOST_FILE environment variable.

local.file "lgtm_host" {
	filename = coalesce(sys.env("LGTM_HOST_FILE"), "/opt/homebrew/etc/grafana-alloy/lgtm-host")
}

prometheus.remote_write "lgtm" {
	endpoint {
		url = "http://" + string.trim_space(local.file.lgtm_host.content) + ":9090/api/v1/write"
	}

	external_labels = {
		host = constants.hostname,
	}
}

// The thermal collector errors on every scrape on Apple Silicon
// ("no CPU power status has been recorded"), so it is off.
prometheus.exporter.unix "node" {
	disable_collectors = ["thermal"]
}

prometheus.scrape "node" {
	targets         = prometheus.exporter.unix.node.targets
	forward_to      = [prometheus.remote_write.lgtm.receiver]
	scrape_interval = "30s"
}

loki.write "lgtm" {
	endpoint {
		url = "http://" + string.trim_space(local.file.lgtm_host.content) + ":3100/loki/api/v1/push"
	}

	external_labels = {
		host = constants.hostname,
	}
}

// Logs of Homebrew-managed services, Alloy's own included.
local.file_match "brew_services" {
	path_targets = [{"__path__" = "/opt/homebrew/var/log/*.log", job = "brew"}]
}

// tail_from_end: do not backfill whatever the files already hold on first start.
loki.source.file "brew_services" {
	targets       = local.file_match.brew_services.targets
	tail_from_end = true
	forward_to    = [loki.write.lgtm.receiver]
}

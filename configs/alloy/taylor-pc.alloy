// Grafana Alloy config for taylor-pc, the LGTM stack host (CachyOS, Alloy from
// the grafana-alloy pacman package, not a container). Runbook: docs/lgtm-taylor-pc.md.
//
// Same node metrics and journal as linux.alloy, plus container logs and
// Grafana's own metrics. On this host the stack is local, so the one-line host
// file holds 127.0.0.1 and Alloy pushes straight to the loopback ports the
// containers publish. A Linux host often cannot reach its own Tailscale Serve
// ports (traffic to its own tailnet address never reaches tailscaled), so this
// does not go through the doors; Gatus on sentinel is what tests the doors.
//   /etc/grafana-alloy/lgtm-host   contains 127.0.0.1
// Override the path with the LGTM_HOST_FILE environment variable.
//
// The grafana-alloy service user needs the `docker` group for the container
// logs below (the socket is root-equivalent; accepted on this host only) and is
// already in `systemd-journal` through the package's sysusers file.

local.file "lgtm_host" {
	filename = coalesce(sys.env("LGTM_HOST_FILE"), "/etc/grafana-alloy/lgtm-host")
}

prometheus.remote_write "lgtm" {
	endpoint {
		url = "http://" + string.trim_space(local.file.lgtm_host.content) + ":9090/api/v1/write"
	}

	external_labels = {
		host = constants.hostname,
	}
}

prometheus.exporter.unix "node" { }

prometheus.scrape "node" {
	targets         = prometheus.exporter.unix.node.targets
	forward_to      = [prometheus.remote_write.lgtm.receiver]
	scrape_interval = "30s"
}

// Grafana listens on host loopback only, which the bridged Prometheus container
// cannot reach, so the host Alloy scrapes it.
prometheus.scrape "grafana" {
	targets         = [{"__address__" = "127.0.0.1:3300"}]
	forward_to      = [prometheus.remote_write.lgtm.receiver]
	job_name        = "grafana"
	scrape_interval = "30s"
}

loki.write "lgtm" {
	endpoint {
		url = "http://" + string.trim_space(local.file.lgtm_host.content) + ":3100/loki/api/v1/push"
	}

	external_labels = {
		host = constants.hostname,
	}
}

loki.relabel "journal" {
	forward_to = []

	rule {
		source_labels = ["__journal__systemd_unit"]
		target_label  = "unit"
	}

	rule {
		source_labels = ["__journal_priority_keyword"]
		target_label  = "level"
	}
}

loki.source.journal "journal" {
	max_age       = "12h"
	labels        = {job = "journal"}
	relabel_rules = loki.relabel.journal.rules
	forward_to    = [loki.write.lgtm.receiver]
}

// Container logs through the Docker socket (json-file driver, rotated by compose).
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}
}

loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	labels     = {job = "docker"}
	forward_to = [loki.write.lgtm.receiver]
}

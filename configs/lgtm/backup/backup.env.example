# Template for ~/.config/lgtm/backup.env on taylor-pc (mode 0600, NEVER committed).
# Loaded by lgtm-backup.service and lgtm-restic-check.service via EnvironmentFile=.
# systemd does not expand $HOME or ~ here, which is why the restic password file
# path is set in the unit with %h and not in this file.
#
# Which stack runs on this host: lgtm (Grafana, Loki, Tempo, Prometheus) or openobserve.
# Decides which containers the nightly backup stops around the copy.
LGTM_STACK=lgtm
#
# restic repository: `rsyncnet-lgtm` is an alias that rsyncnet-own-key.sh writes
# into ~/.ssh/config, so no account id or hostname lives in this file or the repo.
RESTIC_REPOSITORY=sftp:rsyncnet-lgtm:lgtm-restic
# Gatus on sentinel receives the heartbeat pushes (tailnet-only, plain HTTP).
GATUS_URL=http://sentinel.<tailnet>.ts.net:8080
# Bearer token for the lgtm-backup external endpoint. The same value goes into
# sentinel's /etc/gatus/gatus.env as GATUS_LGTM_BACKUP_TOKEN
# (docs/lgtm-taylor-pc.md, Phase 2).
GATUS_LGTM_BACKUP_TOKEN=<generated: openssl rand -hex 24>

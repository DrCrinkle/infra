# Template for ~/.config/lgtm/lgtm.env on taylor-pc (mode 0600, NEVER committed).
# Read by the grafana service in compose.yaml. Create it with the runbook's
# secret-safe command (docs/lgtm-taylor-pc.md, Phase 1); do not paste real
# values into a transcript, a commit or a chat.
#
# Break-glass admin password: random, kept only on this host.
GF_SECURITY_ADMIN_PASSWORD=<generated: openssl rand -base64 24>
# Public URL Grafana is served at, so redirects and cookies match the Serve door.
GF_SERVER_ROOT_URL=https://taylor-pc.<tailnet>.ts.net:8443/

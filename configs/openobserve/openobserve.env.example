# Template for ~/.config/lgtm/openobserve.env on taylor-pc (mode 0600, NEVER committed).
# Read by the openobserve service in compose.yaml. Create it with the runbook's
# secret-safe command (docs/openobserve-taylor-pc.md, Phase 1); do not paste real
# values into a transcript, a commit or a chat.
#
# Root login: an email address you choose and a random password, kept only here.
ZO_ROOT_USER_EMAIL=<your login email>
ZO_ROOT_USER_PASSWORD=<generated: openssl rand -base64 24>
# Public URL the UI is served at, so links and redirects match the Serve door.
ZO_WEB_URL=https://taylor-pc.<tailnet>.ts.net:8443

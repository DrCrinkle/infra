[Unit]
Description=Gatus health dashboard / external watchdog
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=gatus
Environment=GATUS_CONFIG_PATH=/etc/gatus/config.yaml
# Holds NTFY_TOPIC (root:root 0600, not in Git). No "-" prefix on purpose: a
# missing file must stop the unit rather than alert a literal "${NTFY_TOPIC}" topic.
# systemd reads it as root, so DynamicUser=yes still works.
EnvironmentFile=/etc/gatus/gatus.env
ExecStart=/usr/local/bin/gatus
# ICMP checks need raw sockets; grant just that capability to an otherwise
# unprivileged dynamic user.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

[Unit]
Description=edge-lab hello Bun service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opc
Group=opc
WorkingDirectory=/opt/edge-lab/apps/hello-bun
Environment=PORT=3000
Environment=HOME=/opt/edge-lab/apps/hello-bun
ExecStart=/usr/local/bin/bun run server.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

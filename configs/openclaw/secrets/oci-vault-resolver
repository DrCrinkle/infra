#!/usr/bin/python3
"""OpenClaw exec SecretRef resolver -> OCI Vault (instance-principal auth).

Protocol (OpenClaw exec provider, protocolVersion 1):
  stdin : {"protocolVersion":1,"provider":"<name>","ids":["<id>",...]}
  stdout: {"protocolVersion":1,"values":{"<id>":"<secret>",...},"errors":{"<id>":{"message":"..."}}}
Each id is an OCI Vault secret NAME, optionally with an AWS-style "#json_key"
selector to extract a field from a JSON-valued secret. Exit code is always 0;
per-id failures are reported in "errors" so one bad ref never fails the batch.
"""
import os
import sys
import json
import base64

VAULT_ID = os.environ.get("OCI_VAULT_ID") or open(os.path.expanduser("~/.config/openclaw/oci-vault-id")).read().strip()
REGION = "us-sanjose-1"


def main():
    try:
        req = json.load(sys.stdin)
        ids = list(req.get("ids", []))
    except Exception as e:  # malformed request -> surface as a batch-level error
        sys.stdout.write(json.dumps({"protocolVersion": 1, "values": {},
                                     "errors": {"_request": {"message": f"invalid request: {e}"}}}))
        return 0

    import oci  # imported after stdin parse so a bad request fails fast/cheap
    signer = oci.auth.signers.InstancePrincipalsSecurityTokenSigner()
    client = oci.secrets.SecretsClient(config={"region": REGION}, signer=signer)

    values, errors = {}, {}
    cache = {}  # secret_name -> decoded string, so "#a" and "#b" on one secret hit the API once
    for rid in ids:
        name, _, selector = rid.partition("#")
        try:
            if name not in cache:
                bundle = client.get_secret_bundle_by_name(secret_name=name, vault_id=VAULT_ID).data
                cache[name] = base64.b64decode(bundle.secret_bundle_content.content).decode("utf-8")
            raw = cache[name]
            if selector:
                obj = json.loads(raw)
                for part in selector.split("."):
                    obj = obj[part]
                values[rid] = obj if isinstance(obj, str) else json.dumps(obj)
            else:
                values[rid] = raw
        except Exception as e:
            errors[rid] = {"message": str(e)[:200]}

    out = {"protocolVersion": 1, "values": values}
    if errors:
        out["errors"] = errors
    sys.stdout.write(json.dumps(out))
    return 0


sys.exit(main())
